; Moto G20 (java): type declarations for Lineage HAL executables that the
; platform file_contexts references but the stock Unisoc vendor policy does
; not define (the corresponding HAL binaries are not shipped by this port).
; Attributes are platform pub policy attributes (exec_type, vendor_file_type,
; file_type) present in the merged policy.
(type hal_lineage_livedisplay_sysfs_exec)
(typeattributeset exec_type (hal_lineage_livedisplay_sysfs_exec))
(typeattributeset vendor_file_type (hal_lineage_livedisplay_sysfs_exec))
(typeattributeset file_type (hal_lineage_livedisplay_sysfs_exec))
(type hal_lineage_trust_default_exec)
(typeattributeset exec_type (hal_lineage_trust_default_exec))
(typeattributeset vendor_file_type (hal_lineage_trust_default_exec))
(typeattributeset file_type (hal_lineage_trust_default_exec))
(type hal_vibrator_default_exec)
(typeattributeset exec_type (hal_vibrator_default_exec))
(typeattributeset vendor_file_type (hal_vibrator_default_exec))
(typeattributeset file_type (hal_vibrator_default_exec))
