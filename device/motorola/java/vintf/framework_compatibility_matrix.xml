<?xml version="1.0" encoding="UTF-8"?>
<!-- Moto G20 (java): device addendum to the framework compatibility matrix.
     The stock Unisoc/Motorola vendor-extension HALs below are served by the
     device manifest but are unknown to the AOSP framework compatibility
     matrix; declared here as optional so OTA-time checkvintf passes with
     PRODUCT_ENFORCE_VINTF_MANIFEST enabled (see BoardConfig.mk — enforcement
     is required so linkerconfig generates the treble linker configuration
     with the VNDK-apex vendor namespace). -->
<compatibility-matrix version="1.0" type="framework">
    <hal format="hidl" optional="true">
        <name>android.hardware.radio</name>
        <version>1.2</version>
        <interface>
            <name>ISap</name>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>com.fingerprints.extension</name>
        <version>1.0</version>
        <interface>
            <name>IFingerprintEngineering</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IFingerprintNavigation</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IFingerprintSensorTest</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.fpsensor.hardware.fpsensorhidlsvc</name>
        <version>2.0</version>
        <interface>
            <name>IFpsensorHidlSvc</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.aprd</name>
        <version>1.0</version>
        <interface>
            <name>IAprdInfoSync</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.boot</name>
        <version>1.1</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.connmgr</name>
        <version>1.0</version>
        <interface>
            <name>IConnmgr</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.enhance</name>
        <version>1.0</version>
        <interface>
            <name>IEnhance</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.fingerprintmmi</name>
        <version>1.0</version>
        <interface>
            <name>IFingerprintmmi</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.gnss</name>
        <version>2.1</version>
        <interface>
            <name>IGnss</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.log</name>
        <version>1.0</version>
        <interface>
            <name>ILogControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.network</name>
        <version>1.0</version>
        <interface>
            <name>INetworkControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.radio.ims</name>
        <version>1.0</version>
        <interface>
            <name>IImsRadio</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.radio</name>
        <version>1.0</version>
        <interface>
            <name>IExtRadio</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.thermal</name>
        <version>1.0</version>
        <interface>
            <name>IExtThermal</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.thermal</name>
        <version>2.0</version>
        <interface>
            <name>IExtThermal</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.vdsp</name>
        <version>1.0</version>
        <interface>
            <name>IVdspService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.wcn</name>
        <version>1.0</version>
        <interface>
            <name>IWcnVendorInterface</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
