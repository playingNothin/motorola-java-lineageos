// Moto G20 (java): stock vendor SELinux policy sources exposed as filegroups
// so system/sepolicy's vendor context modules can build from the stock blob
// content (see the srcs additions in system/sepolicy/Android.bp).

se_filegroup {
    name: "moto_vendor_property_contexts",
    srcs: ["sepolicy/vendor/vendor_property_contexts"],
}

se_filegroup {
    name: "moto_vendor_file_contexts",
    srcs: ["sepolicy/vendor/vendor_file_contexts"],
}

se_filegroup {
    name: "moto_vendor_hwservice_contexts",
    srcs: ["sepolicy/vendor/vendor_hwservice_contexts"],
}

se_filegroup {
    name: "moto_vendor_service_contexts",
    srcs: ["sepolicy/vendor/vendor_service_contexts"],
}


// Moto G20 (java): Unisoc telephony/IMS SDK boot-classpath jars (2026-09-23).
// The stock ROM puts these on the BOOT classpath (boot-*.vdex evidence in the
// stock system/framework). The IMS cluster apps (ims, ImsCM, SprdVoWifi*,
// radio_interactor_service) import classes from them:
//   ims -> com.android.unisoc.telephony.RadioInteractor (radio_interactor_common)
//          com.unisoc.sdk.common.telephony.UniTelephonyManager (com.unisoc.sdk.common)
// Without them: NoClassDefFoundError kills com.android.phone -> setup crash.
dex_import {
    name: "radio_interactor_common",
    owner: "motorola",
    jars: ["jars/radio_interactor_common.jar"],
}

dex_import {
    name: "com.unisoc.sdk.common",
    owner: "motorola",
    jars: ["jars/com.unisoc.sdk.common.jar"],
}

dex_import {
    name: "uniframework",
    owner: "motorola",
    jars: ["jars/uniframework.jar"],
}

dex_import {
    name: "unisoc_ims_common",
    owner: "motorola",
    jars: ["jars/unisoc_ims_common.jar"],
}
